# Synthetic-data generation and LLM-as-judge (Phase 1 + Phase 3)
ANTHROPIC_API_KEY=

# Experiment tracking (Phase 2). Optional locally; required on the EC2 run.
WANDB_API_KEY=
WANDB_PROJECT=legalmind

# Pushing the trained adapter + model card (Phase 2, end of the AWS window).
# Needs *write* scope. Qwen3 itself is ungated — no token needed to pull it.
HF_TOKEN=

# Spot-interruption checkpointing (Phase 2). Leave blank to disable S3 sync.
LEGALMIND_S3_CHECKPOINT_URI=

# Serving layer (Phase 4). Points the FastAPI gateway at the vLLM backend.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_LORA_NAME=legalmind
